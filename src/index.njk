---
layout: base.njk
title: Latest Headlines
---
<h2 class="text-lg font-bold text-gray-400 uppercase tracking-wider mb-6">Latest Articles</h2>

<div class="space-y-4">
  {% for post in collections.posts %}
    <a href="{{ post.url }}" class="block p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:border-blue-500 hover:shadow-md transition">
      <span class="text-xs font-semibold text-gray-400 uppercase">{{ post.date.toDateString() }}</span>
      <h3 class="text-xl font-bold text-gray-900 mt-1 mb-2">{{ post.data.title }}</h3>
      <p class="text-gray-600 text-sm line-clamp-2">{{ post.data.description }}</p>
    </a>
  {% endfor %}
</div>