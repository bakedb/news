<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or "BeanNet News" }}</title>
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
</head>
<body class="bg-gray-50 text-gray-900 font-sans antialiased min-h-screen flex flex-col">
  <header class="bg-white border-b border-gray-200 py-6">
    <div class="max-w-3xl mx-auto px-4 flex justify-between items-center">
      <a href="/" class="text-2xl font-black tracking-tight text-gray-900 hover:text-blue-600 transition">THE DAILY WIRE</a>
      <span class="text-xs uppercase font-semibold text-gray-400">BeanNew News</span>
    </div>
  </header>

  <main class="max-w-3xl mx-auto px-4 py-8 flex-grow w-full">
    {{ content | safe }}
  </main>

  <footer class="bg-white border-t border-gray-200 py-6 text-center text-sm text-gray-500">
    Published directly from Markdown.
  </footer>
</body>
</html>