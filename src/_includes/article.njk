---
layout: base.njk
---
<article class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
  <header class="mb-6">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2 leading-tight">{{ title }}</h1>
    <time class="text-sm text-gray-400 font-medium">{{ date.toDateString() }}</time>
  </header>
  
  <div class="prose prose-blue max-w-none text-gray-700 leading-relaxed">
    {{ content | safe }}
  </div>
  
  <div class="mt-8 pt-6 border-t border-gray-100">
    <a href="/" class="text-sm font-semibold text-blue-600 hover:underline">Back to News Feed</a>
  </div>
</article>